{
  "name": "lyna-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --host 0.0.0.0",
    "build": "nuxi build",
    "preview": "nuxi preview",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "lint:icons": "node scripts/lint-icons.mjs",
    "lint:conventions": "node scripts/lint-conventions.mjs",
    "lint:locales": "node scripts/lint-locales.mjs",
    "lint:imports": "node scripts/lint-imports.mjs",
    "lint:style": "node scripts/lint-style.mjs",
    "lint:stacked-text": "node scripts/lint-stacked-text.mjs",
    "lint:component-size": "node scripts/lint-component-size.mjs",
    "lint:i18n-keys": "node scripts/lint-i18n-keys.mjs",
    "lint:duplication": "node scripts/lint-duplication.mjs",
    "lint:standalone": "node scripts/lint-standalone.mjs",
    "lint": "npm run lint:icons --silent && npm run lint:conventions --silent && npm run lint:locales --silent && npm run lint:imports --silent && npm run lint:style --silent && npm run lint:stacked-text --silent && npm run lint:component-size --silent && npm run lint:page-titles --silent",
    "lint:audit": "npm run lint:icons --silent && npm run lint:conventions --silent && npm run lint:locales --silent && npm run lint:imports --silent && npm run lint:style --silent && npm run lint:stacked-text --silent && npm run lint:component-size --silent && npm run lint:page-titles --silent && npm run lint:i18n-keys --silent && npm run lint:duplication --silent || true",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:dev": "E2E_DEV_SERVER=1 playwright test",
    "lint:page-titles": "node scripts/lint-page-titles.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "marked": "^18.1.1",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^26.0.0",
    "typescript": "~7.0.0",
    "vue-tsc": "^3.3.13"
  }
}
